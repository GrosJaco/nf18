@startuml

abstract class Projet {
  id_projet {key}
  titre
  description
  objectif_financier
  date_lancement
  /montant_collecte
}
class ProjetTechnologique {
  type_innovation
}
class ProjetArtistique {
  medium_principal
}
class ProjetSocial {
  region_cible
}
Projet <|-- ProjetTechnologique
Projet <|-- ProjetArtistique
Projet <|-- ProjetSocial

class Incubateur {
  id_incubateur {key}
  nom
  annee_creation
  budget_accompagnement
}
class ONG {
  numero_enregistrement {key}
  nom
  pays_origine
}
class MembreEquipe {
  id_membre {key}
  nom
  prenom
  pays_residence
  date_naissance
}
enum Role {
  chefDeProjet
  developpeur
  designer
  communityManager
}
class Participation {
  role: Role
}

class Utilisateur {
  pseudo {key}
  email {unique}
  nom
  date_naissance
}
class Contribution {
  id_contribution {key}
  date_heure
  montant
}
class Avis {
  note
  avis_textuel
  date_avis
}

abstract class Contrepartie {
  id_contrepartie {key}
  libelle
}
class ContrepartieNumerique {
  format_fichier
  taille_mo
}
class ContrepartiePhysique {
  poids_estime
  frais_livraison
}
class Transporteur {
  nom {key}
  delai_livraison_moyen
}
Contrepartie <|-- ContrepartieNumerique
Contrepartie <|-- ContrepartiePhysique

' Associations
Projet "*" -- "0..1" Incubateur : est accompagné par >
Projet "1..*" -- "0..*" MembreEquipe : est porté par >
(Projet, MembreEquipe) .. Participation
ProjetSocial "*" -- "*" ONG : est soutenu par >
Projet "1" -- "*" Contrepartie : propose >
Projet "1" -- "*" Contribution : reçoit >
Utilisateur "1" -- "*" Contribution : effectue >
Contribution "*" -- "0..1" Contrepartie : inclut >
ContrepartiePhysique "*" -- "1" Transporteur : est expédiée par >
Utilisateur "*" -- "*" Projet : évalue >
(Utilisateur, Projet) .. Avis

' Contraintes
note bottom of Avis
  note entre 1 et 5
  Un seul avis par couple (utilisateur, projet)
  Exige au moins une Contribution de l'utilisateur sur ce projet
end note
note bottom of Contribution
  montant > 0
  La Contrepartie choisie doit être proposée par le Projet concerné
end note
note bottom of Participation
  Un seul rôle par couple (membre, projet)
end note
@enduml
