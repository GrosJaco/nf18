@startuml

abstract class Projet {
  id_projet : INT {key}
  titre : VARCHAR
  description : TEXT
  objectif_financier : DECIMAL (€)
  date_lancement : DATE
  /montant_collecte : DECIMAL (€)
}
class ProjetTechnologique {
  type_innovation : VARCHAR
}
class ProjetArtistique {
  medium_principal : VARCHAR
}
class ProjetSocial {
  region_cible : VARCHAR
}
Projet <|-- ProjetTechnologique
Projet <|-- ProjetArtistique
Projet <|-- ProjetSocial

class Incubateur {
  id_incubateur : INT {key}
  nom : VARCHAR
  annee_creation : INT
  budget_accompagnement : DECIMAL (€)
}
class ONG {
  numero_enregistrement : VARCHAR {key}
  nom : VARCHAR
  pays_origine : VARCHAR
}
class MembreEquipe {
  id_membre : INT {key}
  nom : VARCHAR
  prenom : VARCHAR
  pays_residence : VARCHAR
  date_naissance : DATE
}
enum Role {
  chefDeProjet
  developpeur
  designer
  communityManager
}
class Participation {
  role: Role
}

class Utilisateur {
  pseudo : VARCHAR {key}
  email : VARCHAR {unique}
  nom : VARCHAR
  date_naissance : DATE
}
class Contribution {
  id_contribution : INT {key}
  date_heure : DATETIME
  montant : DECIMAL (€)
}
class Avis {
  note : INT
  avis_textuel : TEXT
  date_avis : DATE
}

abstract class Contrepartie {
  id_contrepartie : INT {key}
  libelle : VARCHAR
}
class ContrepartieNumerique {
  format_fichier : VARCHAR
  taille_mo : DECIMAL (Mo)
}
class ContrepartiePhysique {
  poids_estime : DECIMAL (kg)
  frais_livraison : DECIMAL (€)
}
class Transporteur {
  id_transporteur : INT {key}
  nom : VARCHAR {unique}
  delai_livraison_moyen : INT (jours)
}
Contrepartie <|-- ContrepartieNumerique
Contrepartie <|-- ContrepartiePhysique

' Associations
Projet "*" -- "0..1" Incubateur : est accompagné par >
Projet "1..*" -- "0..*" MembreEquipe : est porté par >
(Projet, MembreEquipe) .. Participation
ProjetSocial "0..*" -- "0..*" ONG : est soutenu par >
Projet "1" -- "*" Contrepartie : propose >
Projet "1" -- "*" Contribution : reçoit >
Utilisateur "1" -- "*" Contribution : effectue >
Contribution "*" -- "0..1" Contrepartie : inclut >
ContrepartiePhysique "*" -- "1" Transporteur : est expédiée par >
Utilisateur "*" -- "*" Projet : dépose un avis sur >
(Utilisateur, Projet) .. Avis

' Contraintes
note bottom of Projet
  /montant_collecte = somme des montants des Contributions du projet
end note
note bottom of Avis
  note entre 1 et 5
  Un seul avis par couple (utilisateur, projet)
  Exige au moins une Contribution de l'utilisateur sur ce projet
end note
note bottom of Contribution
  montant > 0
  La Contrepartie choisie doit être proposée par le Projet concerné
end note
note bottom of Participation
  Un seul rôle par couple (membre, projet)
end note
@enduml
